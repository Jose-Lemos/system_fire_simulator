script/source = "extends Control

# Referencias a los paneles
@onready var panel_principal: VBoxContainer = $Panel_Principal
@onready var panel_seleccion_mapa: VBoxContainer = $Panel_SeleccionMapa
@onready var panel_seleccion_nivel: VBoxContainer = $Panel_SeleccionNivel

# Referencias a las listas
@onready var lista_mapas: VBoxContainer = $Panel_SeleccionMapa/ScrollContainer/VBox_ListaMapas
@onready var lista_niveles: VBoxContainer = $Panel_SeleccionNivel/ScrollContainer/VBox_ListaNiveles

# Referencias al nuevo contenedor cuando no hay mapas
@onready var contenedor_vacio: VBoxContainer = $Panel_SeleccionMapa/Contenedor_Vacio
@onready var scroll_lista: ScrollContainer = $Panel_SeleccionMapa/ScrollContainer

# Referencias a diálogos
@onready var file_dialog: FileDialog = $FileDialog_Json
@onready var window_mapa_manual: Window = $Window_CrearMapaManual

# Botones dentro del contenedor \"vacio\"
@onready var btn_crear_vacio: Button = $Panel_SeleccionMapa/Contenedor_Vacio/Btn_CrearVacio
@onready var btn_cargar_vacio: Button = $Panel_SeleccionMapa/Contenedor_Vacio/Btn_CargarVacio

# Botones inferiores
@onready var btn_volver_mapas: Button = $Panel_SeleccionMapa/Contenedor_Vacio/Btn_VolverPrincipal

# Panel Selección Nivel
@onready var btn_volver_niveles: Button = $Panel_SeleccionNivel/HBoxContainer/Btn_VolverMapas
# Precargar la escena de juego
const SCENA_JUEGO = preload(\"res://scenes/menu_principal.tscn\")

# Variables de estado
var mapa_seleccionado_ruta: String = \"\"

func _ready() -> void:
	_conectar_botones()
	_ir_a_panel_principal()
	# Conectar FileDialog (usaremos una sola función centralizada)
	if not file_dialog.file_selected.is_connected(_on_file_dialog_file_selected):
		file_dialog.file_selected.connect(_on_file_dialog_file_selected)

func _conectar_botones() -> void:
	# Panel Principal
	if $Panel_Principal/Btn_Jugar.pressed.is_connected(_on_jugar_pressed) == false:
		$Panel_Principal/Btn_Jugar.pressed.connect(_on_jugar_pressed)
	if $Panel_Principal/Btn_CargarExterno.pressed.is_connected(_on_cargar_externo_pressed) == false:
		$Panel_Principal/Btn_CargarExterno.pressed.connect(_on_cargar_externo_pressed)
	
	# Panel Selección Mapa
	if btn_crear_vacio.pressed.is_connected(_on_nuevo_mapa_manual_pressed) == false:
		btn_crear_vacio.pressed.connect(_on_nuevo_mapa_manual_pressed)
	if btn_cargar_vacio.pressed.is_connected(_on_cargar_externo_pressed) == false:
		btn_cargar_vacio.pressed.connect(_on_cargar_externo_pressed)
		

	if btn_volver_mapas.pressed.is_connected(_ir_a_panel_principal) == false:
		btn_volver_mapas.pressed.connect(_ir_a_panel_principal)
	

	if btn_volver_niveles.pressed.is_connected(_ir_a_panel_seleccion_mapa) == false:
		btn_volver_niveles.pressed.connect(_ir_a_panel_seleccion_mapa)

func _resetear_paneles() -> void:
	panel_principal.hide()
	panel_seleccion_mapa.hide()
	panel_seleccion_nivel.hide()

# --- MÁQUINA DE ESTADOS ---

func _ir_a_panel_principal() -> void:
	_resetear_paneles()
	panel_principal.show()

func _ir_a_panel_seleccion_mapa() -> void:
	_resetear_paneles()
	panel_seleccion_mapa.show()
	_poblar_lista_mapas()

func _ir_a_panel_seleccion_nivel(nombre_mapa: String) -> void:
	_resetear_paneles()
	panel_seleccion_nivel.show()
	$Panel_SeleccionMapa/Label_Seleccion.text = \"Simulaciones para: \" + nombre_mapa
	_poblar_lista_niveles(nombre_mapa)

# --- LÓGICA DE BOTONES PRINCIPALES ---

func _on_jugar_pressed() -> void:
	# Al presionar Jugar, siempre vamos a la pantalla de selección de mapa
	_ir_a_panel_seleccion_mapa()

func _on_cargar_externo_pressed() -> void:
	# Configuramos el FileDialog para importar JSON
	file_dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	file_dialog.clear_filters()
	file_dialog.add_filter(\"*.json ; Archivos de Mapa JSON\")
	file_dialog.popup_centered()

# --- POBLAR LISTAS (Creación dinámica de botones) ---

func _poblar_lista_mapas() -> void:
	# Limpiar lista anterior
	for btn in lista_mapas.get_children():
		btn.queue_free()
	
	contenedor_vacio.show()
	# Comprobar si hay mapas
	if DataManager.mapas_disponibles.is_empty():
		# CASO: NO HAY MAPAS
		#scroll_lista.hide()
		$Panel_SeleccionMapa/Label_Mensaje.show()
	else:
		# CASO: HAY MAPAS
		$Panel_SeleccionMapa/Label_Mensaje.hide()
		#scroll_lista.show()
		
		for info_mapa in DataManager.mapas_disponibles:
			var btn = Button.new()
			btn.text = info_mapa.nombre
			btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
			btn.custom_minimum_size = Vector2(0, 45)
			# Conectar para seleccionar mapa e ir a niveles
			btn.pressed.connect(func(): _on_mapa_interno_seleccionado(info_mapa.ruta, info_mapa.nombre))
			lista_mapas.add_child(btn)
		
# Única función que recibe el archivo seleccionado del diálogo
#func _on_file_dialog_file_selected(path: String) -> void:
	#print(\"JSON seleccionado, cambiando a escena Mapa-Reserva: \", path)
	
	# Pedir al GameManager que cambie a la escena de Reserva y pase la ruta
	#GameManager.ir_a_mapa_reserva(path)
	# En MenuPrincipal.gd
func _on_file_dialog_file_selected(path_json: String) -> void:
	# 1. Lógica de rutas
	var nombre_archivo = path_json.get_file().get_basename()
	var ruta_tres_out = \"user://data/maps_out/\" + nombre_archivo + \".tres\"
	
	# 2. Importar y guardar el recurso .tres
	var datos = MapManager.importar_json_y_guardar_recurso(path_json, ruta_tres_out)
	
	if datos:
		# 3. Usamos la función del GameManager para cambiar de escena de forma segura y diferida
		GameManager.ir_a_jugar_mapa_guardado(ruta_tres_out)
		GameManager.es_importacion = true
	
func _poblar_lista_niveles(nombre_mapa: String) -> void:
	# Limpiar lista anterior
	for btn in lista_niveles.get_children():
		btn.queue_free()
		
	# LÓGICA PENDIENTE: Tu recurso SaveData debe guardar una lista de nombres de simulaciones.
	# Ejemplo conceptual:
	var mapa_data = DataManager.cargar_mapa_recurso(mapa_seleccionado_ruta)
	if mapa_data and \"lista_simulaciones\" in mapa_data:
		for nombre_sim in mapa_data.lista_simulaciones:
			var btn = Button.new()
			btn.text = nombre_sim
			# Al hacer clic, cargar el mapa Y la simulación específica
			btn.pressed.connect(func(): _iniciar_juego(mapa_seleccionado_ruta, nombre_sim))
			lista_niveles.add_child(btn)
	
	# Opción siempre presente: Crear nueva
	var btn_nuevo = Button.new()
	btn_nuevo.text = \"+ Crear Nueva Simulación\"
	btn_nuevo.add_theme_color_override(\"font_color\", Color.GOLD)
	btn_nuevo.pressed.connect(func(): _iniciar_juego(mapa_seleccionado_ruta, \"\")) # Cadena vacía = Nuevo
	lista_niveles.add_child(btn_nuevo)

# --- SELECCIÓN Y CARGA ---

func _on_mapa_interno_seleccionado(ruta: String, nombre: String) -> void:
	mapa_seleccionado_ruta = ruta
	
	# 1. Indicamos al GameManager qué ruta de mapa .tres debe cargar la escena de juego
	#GameManager.ruta_json_pendiente = ruta
	GameManager.mapa_a_cargar_ruta = ruta
	GameManager.es_importacion = false # Indicamos que es un mapa existente, no una importación de JSON
	
	# 2. Ejecutamos el cambio de escena hacia la pantalla de juego/mapa principal
	#get_tree().change_scene_to_packed(SCENA_JUEGO)
	#GameManager.ir_a_mapa_reserva(mapa_seleccionado_ruta)
	GameManager.ir_a_jugar_mapa_guardado(ruta)

func _on_mapa_externo_seleccionado(ruta: String) -> void:
	# 1. Usas tu lógica actual de parseo JSON para convertirlo a objeto SaveData
	# var datos_nuevos = importar_y_parsear_json(ruta)
	
	# 2. Pedir nombre al usuario para guardarlo internamente (ventana emergente)
	# window_pedir_nombre.popup_centered()
	# Al confirmar el nombre:
	# DataManager.guardar_mapa(datos_nuevos, nombre_ingresado)
	# mapa_seleccionado_ruta = ruta_generada
	# _ir_a_panel_seleccion_nivel(nombre_ingresado)
	print(\"Importando y pendiente de guardar: \", ruta)
	# Simulación de flujo:
	var nombre_falso = ruta.get_file().get_basename()
	# ... (aquí iría la lógica real de guardado)
	_on_mapa_interno_seleccionado(\"user://mapas/\" + nombre_falso + \".tres\", nombre_falso)

func _iniciar_juego(ruta_mapa: String, nombre_simulacion: String) -> void:
	# Cambiar a la escena principal del juego
	var juego = SCENA_JUEGO.instantiate()
	get_tree().root.add_child(juego)
	
	# Pasar datos al cargador del juego
	# juego.get_node(\"MapLoader\").cargar_mapa_y_nivel(ruta_mapa, nombre_simulacion)
	
	queue_free()

# --- CREACIÓN MANUAL ---
func _on_nuevo_mapa_manual_pressed() -> void:
	# Abrir ventana con campos para Nombre, Ancho, Alto.
	# Al aceptar, generar matriz vacía, crear SaveData, guardar en DataManager
	# y llamar a _on_mapa_interno_seleccionado()
	# Pedir al GameManager que cambie a la escena de edición (paletas)
	GameManager.ir_a_crear_mapa_nuevo()
"

